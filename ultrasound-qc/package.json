{
  "name": "ultrasound-qc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "build/main.cjs",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node scripts/build-electron.mjs",
    "start": "npm run build && electron .",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {"react": "^19.0.0", "react-dom": "^19.0.0", "zod": "^4.0.0"},
  "devDependencies": {"@types/node": "^24.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "@vitejs/plugin-react": "^5.0.0", "@playwright/test": "^1.56.0", "electron": "^40.0.0", "electron-builder": "^26.0.0", "esbuild": "^0.25.0", "typescript": "^5.9.0", "vite": "^7.0.0", "vitest": "^3.2.0"},
  "build": {"appId": "local.ultrasound.qc", "productName": "UltrasoundQC", "directories": {"output": "dist"}, "files": ["build/**/*", "web/**/*", "package.json"], "extraResources": [{"from": "python/qcworker", "to": "qcworker"}, {"from": ".runtime/config.json", "to": "runtime.json"}], "win": {"signAndEditExecutable": false}}
}
